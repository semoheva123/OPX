{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "app.js",
          "*.svg",
          "dist/**",
          "styles/**",
          "sw.js",
          "manifest.json",
          "robots.txt",
          "sitemap.xml"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/reset-daily-tasks",
      "schedule": "0 0 * * *"
    }
  ]
}
