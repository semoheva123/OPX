# Production environment template for OPERIX
# Copy to .env and fill with real values before deployment.
NODE_ENV=production
APP_URL=https://operix.website
ALLOWED_ORIGINS=https://operix.website

# Core auth + runtime
TRUST_PROXY=true
JWT_SECRET=replace_with_very_long_random_secret
CRON_SECRET=replace_with_secure_random_secret

# Active database mode for the project
# supabase = Supabase-only production mode
DATABASE_MODE=supabase
SUPABASE_URL=https://ndjkisvvyrslerrecqyo.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.ndjkisvvyrslerrecqyo.supabase.co:5432/postgres

# Email delivery (must use a verified custom domain; never use resend.dev in production)
EMAIL_FROM=OPERIX <noreply@operix.website>
RESEND_API_KEY=

# Realtime
ABLY_API_KEY=

# External image storage (images are never stored by OPERIX)
IMGBB_API_KEY=

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# CPAlead publisher offerwall
CPALEAD_WALL_SLUG=
CPALEAD_POSTBACK_PASSWORD=
CPALEAD_USER_REWARD_SHARE=0.7

# Blockchain / wallets
TRON_DEPOSIT_XPUB=your_public_extended_key_for_dedicated_tron_deposit_wallet
TRON_DEPOSIT_AUTOMATION_ENABLED=false
TRON_DEPOSIT_SCAN_BATCH=10
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Automatic TRC20 withdrawal sending (keep this private key only in hosting secrets; use a dedicated hot wallet)
WITHDRAWAL_PAYOUTS_ENABLED=false
TRON_WITHDRAWAL_PRIVATE_KEY=
WITHDRAWAL_MAX_SINGLE_USDT=5000
TRON_WITHDRAWAL_FEE_LIMIT_SUN=100000000
TRON_WITHDRAWAL_MIN_TRX_SUN=100000000
TRONGRID_SOLIDITY_API_URL=https://api.trongrid.io

# Automatic approval is separately gated; defaults leave withdrawals manual and capped
WITHDRAWAL_AUTO_APPROVAL_ENABLED=false
WITHDRAWAL_AUTO_APPROVAL_ADMIN_ID=
WITHDRAWAL_AUTO_MAX_SINGLE_USDT=100
WITHDRAWAL_AUTO_DAILY_LIMIT_USDT=250
WITHDRAWAL_AUTO_MAX_RISK_SCORE=20
WITHDRAWAL_AUTO_DELAY_MINUTES=30

# Optional overrides
TRONGRID_API_KEY=
TRONGRID_API_URL=https://api.trongrid.io
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
VAULT_OWNER_USER_ID=
